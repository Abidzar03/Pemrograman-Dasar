<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Simulasi tabungan"/>
        <attribute name="authors" value="HYPE AMD"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-23 11:09:46 PM"/>
        <attribute name="created" value="SFlQRSBBTUQ7QUJJRDsyMDI2LTA5LTIzOzEwOjU0OjU2IFBNOzIxMTM="/>
        <attribute name="edited" value="SFlQRSBBTUQ7QUJJRDsyMDI2LTA5LTIzOzExOjA5OjQ2IFBNOzE7MjIyMQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="jumlahBulan, bulan, nominal, totalTabungan, bulanTercapai" type="Integer" array="False" size=""/>
            <assign variable="nominal" expression="100000"/>
            <assign variable="totalTabungan" expression="0"/>
            <assign variable="bulanTercapai" expression="0"/>
            <input variable="jumlahBulan"/>
            <for variable="bulan" start="1" end="jumlahBulan" direction="inc" step="1">
                <assign variable="totalTabungan" expression="totalTabungan + nominal"/>
                <output expression="&quot;Bulan &quot; &amp; bulan &amp; &quot;: Rp&quot; &amp; nominal &amp; &quot; | Total: Rp&quot; &amp; totalTabungan" newline="True"/>
                <if expression="totalTabungan &gt;= 1000000">
                    <then>
                        <assign variable="bulanTercapai" expression="bulan"/>
                        <breakpoint expression="" always="True"/>
                    </then>
                    <else/>
                </if>
                <assign variable="nominal" expression="nominal + 50000"/>
            </for>
            <output expression="&quot;Total Tabungan: Rp&quot; &amp; totalTabungan" newline="True"/>
            <if expression="bulanTercapai &gt; 0">
                <then>
                    <output expression="&quot;Total pertama kali mencapai Rp1.000.000 pada bulan ke-&quot; &amp; bulanTercapai" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Total tabungan belum mencapai Rp1.000.000 dalam &quot; &amp; jumlahBulan &amp; &quot; bulan.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
