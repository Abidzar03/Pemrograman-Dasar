<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="perhitungan"/>
        <attribute name="authors" value="HYPE AMD"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-03 03:38:22 PM"/>
        <attribute name="created" value="SFlQRSBBTUQ7QUJJRDsyMDI2LTA5LTAzOzAyOjI4OjAzIFBNOzIxMDU="/>
        <attribute name="edited" value="SFlQRSBBTUQ7QUJJRDsyMDI2LTA5LTAzOzAzOjM4OjIyIFBNOzI7MjIxNw=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="pilihan" type="Integer" array="False" size=""/>
            <declare name="sisi1" type="Integer" array="False" size=""/>
            <declare name="alas" type="Integer" array="False" size=""/>
            <declare name="tinggi" type="Integer" array="False" size=""/>
            <declare name="jari" type="Integer" array="False" size=""/>
            <declare name="hasil1" type="Integer" array="False" size=""/>
            <declare name="hasil2" type="Integer" array="False" size=""/>
            <output expression="&quot;nomer 1/2/3&quot;" newline="True"/>
            <input variable="pilihan"/>
            <if expression="pilihan == 1">
                <then>
                    <output expression="&quot;menghitung keliling dan luas persegi&quot;" newline="True"/>
                    <output expression="&quot;masukkan angka&quot;" newline="True"/>
                    <input variable="sisi1"/>
                    <assign variable="hasil1" expression="4*sisi1"/>
                    <output expression="&quot;hasil keliling =&quot; &amp;hasil1" newline="True"/>
                    <assign variable="hasil2" expression="sisi1*sisi1"/>
                    <output expression="&quot;hasil luas = &quot; &amp;hasil2" newline="True"/>
                </then>
                <else>
                    <if expression="pilihan == 2">
                        <then>
                            <output expression="&quot;menghitung keliling dan luas segitiga&quot;" newline="True"/>
                            <output expression="&quot;masukkan sisi&quot;" newline="True"/>
                            <input variable="sisi1"/>
                            <output expression="&quot;masukkan alas&quot;" newline="True"/>
                            <input variable="alas"/>
                            <output expression="&quot;masukkan tinggi&quot;" newline="True"/>
                            <input variable="tinggi"/>
                            <assign variable="hasil1" expression="sisi1+sisi1+sisi1"/>
                            <output expression="&quot;hasil keliling =&quot; &amp;hasil1" newline="True"/>
                            <assign variable="hasil2" expression="1/2*alas*tinggi"/>
                            <output expression="&quot;hasil luas = &quot; &amp;hasil2" newline="True"/>
                        </then>
                        <else>
                            <if expression="pilihan == 3">
                                <then>
                                    <output expression="&quot;menghitung keliling dan luas lingkaran&quot;" newline="True"/>
                                    <output expression="&quot;masukkan jari-jari&quot;" newline="True"/>
                                    <input variable="jari"/>
                                    <assign variable="hasil1" expression="2*3.14*jari"/>
                                    <output expression="&quot;hasil keliling =&quot; &amp;hasil1" newline="True"/>
                                    <assign variable="hasil2" expression="3.14*jari"/>
                                    <output expression="&quot;hasil luas = &quot; &amp;hasil2" newline="True"/>
                                </then>
                                <else>
                                    <output expression="&quot;tidak ada pilihan silahkan coba lagi&quot;" newline="True"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
