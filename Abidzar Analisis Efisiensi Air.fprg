<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Abidzar Analisis Efisiensi Air"/>
        <attribute name="authors" value="HYPE AMD"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-08 09:15:46 PM"/>
        <attribute name="created" value="SFlQRSBBTUQ7QUJJRDsyMDI2LTA5LTA4OzA4OjE3OjM5IFBNOzIxMjM="/>
        <attribute name="edited" value="SFlQRSBBTUQ7QUJJRDsyMDI2LTA5LTA4OzA5OjE1OjQ2IFBNOzE7MjIyOA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="kebutuhanSebelum, persenPenghematan, jumlahPenghematan, kebutuhanSesudah" type="Real" array="False" size=""/>
            <input variable="kebutuhansebelum"/>
            <assign variable="persenPenghematan" expression="0.15"/>
            <assign variable="jumlahPenghematan" expression="kebutuhanSebelum * 0.15"/>
            <assign variable="kebutuhanSesudah" expression="kebutuhanSebelum - jumlahPenghematan"/>
            <output expression="&quot;kebutuhanSebelum: &quot; &amp;kebutuhanSebelum&amp; &quot; liter&quot;" newline="True"/>
            <output expression="&quot;jumlahPenghematan: &quot; &amp;jumlahPenghematan&amp;&quot; liter&quot;" newline="True"/>
            <output expression="&quot;kebutuhanSesudah: &quot; &amp;kebutuhanSesudah&amp;&quot; liter&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
